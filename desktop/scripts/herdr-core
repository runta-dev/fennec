#!/usr/bin/env bash
# Checks (or, with --update <herdr-app checkout>, copies) the files Fennec keeps
# exactly as herdr-app ships them. Usage:
#   scripts/herdr-core check  <herdr-app checkout>   differences from that checkout
#   scripts/herdr-core update <herdr-app checkout>   copy them over, then rebuild and test
set -euo pipefail
cd "$(dirname "$0")/.."
mode=${1:?check|update}; herdr=${2:?herdr-app checkout}
status=0
while read -r path; do
  case "$path" in ''|'#'*) continue ;; esac
  if [ "$mode" = update ]; then
    mkdir -p "$(dirname "$path")"; rm -rf "$path"; cp -R "$herdr/$path" "$path"
  elif ! diff -rq "$herdr/$path" "$path" >/dev/null; then
    echo "differs: $path"; status=1
  fi
done < <(sed -n '/^```verbatim/,/^```$/p' UPSTREAM.md | sed '1d;$d')
[ "$mode" = update ] && echo "updated from $(git -C "$herdr" rev-parse --short HEAD); record it in UPSTREAM.md"
exit $status
